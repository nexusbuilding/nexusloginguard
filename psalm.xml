<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
	phpVersion="8.1"
>
    <projectFiles>
        <directory name="lib" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
	<issueHandlers>
		<UndefinedDocblockClass>
			<errorLevel type="suppress">
				<!-- Doctrine is shipped by Nextcloud server, not by the OCP stubs -->
				<referencedClass name="Doctrine\DBAL\Schema\Table"/>
				<referencedClass name="Doctrine\DBAL\Schema\Column"/>
				<referencedClass name="Doctrine\DBAL\Schema\Index"/>
				<referencedClass name="Doctrine\DBAL\Schema\Sequence"/>
			</errorLevel>
		</UndefinedDocblockClass>
	</issueHandlers>
	<extraFiles>
		<directory name="vendor"/>
	</extraFiles>
</psalm>
